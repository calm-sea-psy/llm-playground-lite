# 복사해서 .env 로 저장하면 자동 로드된다.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# 에어코리아 + 특일정보 공통 (data.go.kr 활용신청)
DATA_GO_KR_API_KEY=

# 클라우드 기준선 전용 — 비워 두면 기준선 실행만 호출 전에 실패하고 로컬 측정은 영향 없다
# 값 자리에 주석을 두지 않는다 — `키=  # 설명` 꼴로 적으면 주석이 값으로 읽혀 키가 있는 것처럼 보인다
OPENAI_API_KEY=

# 리포트 PDF의 한글 폰트 파일 — 줄째 없으면 맑은 고딕(C:\Windows\Fonts\malgun.ttf)을 쓴다. Windows가 아니면 주석을 풀고 경로를 적는다.
# 빈 값으로 풀어 두면 기본값이 아니라 빈 경로를 읽으므로, 바꿀 때만 푼다.
# REPORT_FONT_PATH=

# 측정 기계 이름 — 주 기계에서는 비워 둔다(main으로 기록). 보조 PC에서 잴 때만 적는다(예: laptop).
MEASUREMENT_MACHINE=
